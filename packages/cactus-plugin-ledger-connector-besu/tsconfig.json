      "path": "../cactus-core/tsconfig.json"
    },
    {
      "path": "../cactus-core-api/tsconfig.json"
    },
    {
      "path": "../cactus-plugin-keychain-memory/tsconfig.json"
    },
    {
      "path": "../cactus-test-tooling/tsconfig.json"
