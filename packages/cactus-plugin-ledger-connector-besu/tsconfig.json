{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist/lib/",
    "declarationDir": "dist/lib",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "tsBuildInfoFile": "../../.build-cache/cactus-plugin-ledger-connector-besu.tsbuildinfo",
    "baseUrl": ".", 
    "paths": {
